<%- include('partials/header', { title: 'Modifica pagina ' + page.id }) %>

<%
const allItems = [...templates, ...elements];
let dynamicCss = '';
for (const item of allItems) {
  dynamicCss += `.badge-${item.name}{background:#${item.color};color:#${item.text_color}}\n`;
}
%>
<style><%= dynamicCss %></style>

<%- include('partials/nav', { project, user: null }) %>

<div class="main-content">
  <h1 class="page-title">Modifica pagina <code><%= page.id %></code></h1>

  <form method="POST" action="/sitemap/edit" class="edit-form">
    <input type="hidden" name="projectId" value="<%= project.id %>">
    <input type="hidden" name="pageId"    value="<%= page.id %>">

    <div class="form-grid">

      <label>Nome pagina</label>
      <input type="text" name="label" value="<%= page.label %>" maxlength="255" class="field-text" required>

      <label>Versione</label>
      <input type="text" name="version" value="<%= page.version %>" maxlength="50" class="field-text" placeholder="es. 1.0">

      <label>Scope matrix</label>
      <input type="text" name="contentMatrix" value="<%= page.content_matrix %>" maxlength="255" class="field-text">

      <label>Descrizione</label>
      <textarea name="description" class="field-text" rows="3"><%= page.description %></textarea>

      <label>Pagina riservata</label>
      <label class="checkbox-label">
        <input type="checkbox" name="locked" value="on" <%= page.locked ? 'checked' : '' %>>
        <span>Accesso riservato</span>
      </label>

      <label>Template</label>
      <select name="template" class="field-select">
        <option value="def"<%= page.template === 'def' ? ' selected' : '' %>>— nessuno (def) —</option>
        <% for (const t of templates) { %>
          <option value="<%= t.name %>" <%= page.template === t.name ? 'selected' : '' %>>
            <%= t.name %> – <%= t.description %>
          </option>
        <% } %>
      </select>

      <label>Elementi in pagina</label>
      <div class="elements-list">
        <% for (const e of elements) { %>
          <label class="checkbox-label">
            <input type="checkbox" name="elements" value="<%= e.name %>"
              <%= pageElements.includes(e.name) ? 'checked' : '' %>>
            <span class="badge badge-<%= e.name %>"><%= e.name %></span>
            <span class="el-desc"><%= e.description %></span>
          </label>
        <% } %>
        <% if (elements.length === 0) { %>
          <span class="muted">Nessun elemento definito. <a href="/templates?projectId=<%= project.id %>" class="link-accent">Aggiungine uno.</a></span>
        <% } %>
      </div>

    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Salva</button>
      <a href="/sitemap?projectId=<%= project.id %>" class="btn btn-secondary">Annulla</a>
    </div>
  </form>

  <hr class="section-sep">
  <h2 class="section-title">Allegati</h2>

  <% if (attachments.length > 0) { %>
    <table class="data-table" style="margin-bottom:16px;max-width:700px">
      <thead>
        <tr><th>File</th><th>Tipo</th><th>Dimensione</th><th></th></tr>
      </thead>
      <tbody>
        <% for (const att of attachments) { %>
          <tr>
            <td><a href="/sitemap/attachment/<%= att.id %>" class="link-accent"><%= att.filename %></a></td>
            <td><code><%= att.mimetype %></code></td>
            <td class="col-num"><%= (att.size / 1024).toFixed(1) %> KB</td>
            <td>
              <form method="POST" action="/sitemap/delete-attachment" style="display:inline">
                <input type="hidden" name="projectId"    value="<%= project.id %>">
                <input type="hidden" name="pageId"       value="<%= page.id %>">
                <input type="hidden" name="attachmentId" value="<%= att.id %>">
                <button type="submit" class="btn btn-sm btn-danger">Elimina</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } else { %>
    <p class="muted" style="margin-bottom:14px">Nessun allegato.</p>
  <% } %>

  <form method="POST" action="/sitemap/upload-attachment" enctype="multipart/form-data">
    <input type="hidden" name="projectId" value="<%= project.id %>">
    <input type="hidden" name="pageId"    value="<%= page.id %>">
    <div class="inline-form-row">
      <input type="file" name="files" multiple class="field-text" style="max-width:420px">
      <button type="submit" class="btn btn-secondary btn-sm">Carica</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
