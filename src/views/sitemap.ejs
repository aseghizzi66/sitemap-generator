<%- include('partials/header', { title: project.name }) %>

<%
// CSS dinamico: un blocco <style> con le classi generate dai template/elementi
const allItems = [...templates, ...elements];
let dynamicCss = '';
for (const item of allItems) {
  dynamicCss += `.badge-${item.name}{background:#${item.color};color:#${item.text_color}}` + '\n';
  dynamicCss += `.card-body-${item.name}{background:#${item.color}22;border-left:3px solid #${item.color}}` + '\n';
}
%>
<style><%= dynamicCss %></style>

<%- include('partials/nav', { project, user }) %>

<div class="info-bar">
  <div class="info-panels">

    <%/* ── Pannello Templates ── */%>
    <div class="info-panel">
      <div class="info-panel-header">
        Master Templates
        <a href="/templates?projectId=<%= project.id %>" class="link-accent" style="font-size:11px">EDIT</a>
      </div>
      <table class="mini-table">
        <thead><tr><th>Nome</th><th>Descrizione</th><th>Nr</th></tr></thead>
        <tbody>
          <% for (const t of templates) { %>
            <tr>
              <td><span class="badge badge-<%= t.name %>"><%= t.name %></span></td>
              <td><%= t.description %></td>
              <td class="col-num"><%= t.usage_count %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <%/* ── Pannello Elementi ── */%>
    <div class="info-panel">
      <div class="info-panel-header">
        Elementi
        <a href="/templates?projectId=<%= project.id %>" class="link-accent" style="font-size:11px">EDIT</a>
      </div>
      <table class="mini-table">
        <thead><tr><th>Nome</th><th>Descrizione</th><th>Nr</th></tr></thead>
        <tbody>
          <% for (const e of elements) { %>
            <tr>
              <td><span class="badge badge-<%= e.name %>"><%= e.name %></span></td>
              <td><%= e.description %></td>
              <td class="col-num"><%= e.usage_count %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<%/* ─────────────────────────────────────────────────────────────
     TOOLBAR — controllo layout orizzontale
────────────────────────────────────────────────────────────── */%>
<div class="tree-toolbar">
  <label for="layoutSelect" class="toolbar-label">Mostra in orizzontale</label>
  <select id="layoutSelect" class="field-select toolbar-select" onchange="applyTreeLayout()">
    <option value="never">Mai</option>
    <option value="1">Sempre (dal 1° livello)</option>
    <option value="2">Dal 2° livello</option>
    <option value="3">Dal 3° livello</option>
    <option value="4">Dal 4° livello</option>
  </select>
</div>

<%/* ─────────────────────────────────────────────────────────────
     TREE — funzione ricorsiva EJS
────────────────────────────────────────────────────────────── */%>
<div class="tree-container">
<%

const iconEdit = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`;
const iconAdd  = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`;
const iconDel  = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>`;

function renderNode(node, depth) {
  const tpl       = node.template || 'def';
  const isLocked  = node.locked;
  const canDelete = node.id !== '0';
  const pid       = project.id;

  let h = '';
  h += `<div class="tree-node-wrap">`;

    h += `<div class="tree-card-row">`;

      h += `<div class="node-actions">`;
        h += `<a href="/sitemap/edit?projectId=${pid}&pageId=${encodeURIComponent(node.id)}" class="act act-edit" title="Modifica">${iconEdit}</a>`;
        h += `<form method="POST" action="/sitemap/add" class="act-form">
          <input type="hidden" name="projectId" value="${pid}">
          <input type="hidden" name="pageId"    value="${node.newChildId}">
          <button class="act act-add" title="Aggiungi figlio">${iconAdd}</button>
        </form>`;
        if (canDelete) {
          h += `<form method="POST" action="/sitemap/delete" class="act-form">
            <input type="hidden" name="projectId" value="${pid}">
            <input type="hidden" name="pageId"    value="${node.id}">
            <button class="act act-del" title="Elimina">${iconDel}</button>
          </form>`;
        }
      h += `</div>`;

      h += `<div class="tree-card">`;
        h += `<div class="tree-card-head"><span class="node-id">${node.id}</span></div>`;
        h += `<div class="tree-card-body card-body-${tpl}">`;
        if (isLocked) h += `<span class="lock-icon" title="Pagina riservata">🔒</span> `;
        h += `<span class="card-label">${node.label}</span>`;
        h += `<div class="card-tpl"><span class="badge badge-${tpl}">${tpl}</span></div>`;
        if (node.elements && node.elements.length > 0) {
          h += `<div class="card-elems">`;
          for (const el of node.elements) h += `<span class="badge badge-${el}">${el}</span> `;
          h += `</div>`;
        }
        if (node.version) h += `<div class="card-ver">v${node.version}</div>`;
        h += `</div>`;
      h += `</div>`;

    h += `</div>`;

    if (node.children && node.children.length > 0) {
      // data-level = profondità dei figli (1 = figli del root, 2 = nipoti, ...)
      h += `<div class="tree-children" data-level="${depth + 1}">`;
      for (const child of node.children) {
        h += renderNode(child, depth + 1);
      }
      h += `</div>`;
    }

  h += `</div>`;
  return h;
}

for (const root of tree) {
  %><%- renderNode(root, 0) %><%
}
%>
</div>

<script>
function drawSiblingConnectors() {
  document.querySelectorAll('.h-sibling-line').forEach(el => el.remove());
  document.querySelectorAll('.tree-children.horizontal').forEach(container => {
    const wraps = [...container.querySelectorAll(':scope > .tree-node-wrap')];
    if (wraps.length < 2) return;
    const cr = container.getBoundingClientRect();
    for (let i = 0; i < wraps.length - 1; i++) {
      const card1 = wraps[i].querySelector('.tree-card');
      const card2 = wraps[i + 1].querySelector('.tree-card');
      if (!card1 || !card2) continue;
      const r1 = card1.getBoundingClientRect();
      const r2 = card2.getBoundingClientRect();
      /* only connect cards on the same row */
      if (Math.abs(r1.top - r2.top) > 40) continue;
      const y    = wraps[i].getBoundingClientRect().top - cr.top + 28;
      const left = r1.right - cr.left;
      const w    = r2.left  - r1.right;
      if (w <= 0) continue;
      const line = document.createElement('div');
      line.className = 'h-sibling-line';
      line.style.cssText = `left:${left}px;top:${y}px;width:${w}px;`;
      container.appendChild(line);
    }
  });
}

function scheduleConnectors() {
  /* double rAF ensures layout is fully settled after class changes */
  requestAnimationFrame(() => requestAnimationFrame(drawSiblingConnectors));
}

function applyTreeLayout() {
  const val       = document.getElementById('layoutSelect').value;
  const fromLevel = val === 'never' ? Infinity : parseInt(val);
  document.querySelectorAll('.tree-children').forEach(el => {
    const level = parseInt(el.dataset.level);
    el.classList.toggle('horizontal', level >= fromLevel);
  });
  localStorage.setItem('sitemapLayout', val);
  scheduleConnectors();
}

window.addEventListener('resize', drawSiblingConnectors);

document.addEventListener('DOMContentLoaded', () => {
  const saved = localStorage.getItem('sitemapLayout');
  if (saved) {
    const sel = document.getElementById('layoutSelect');
    if (sel) sel.value = saved;
  }
  applyTreeLayout();
});
</script>

<%- include('partials/footer') %>
